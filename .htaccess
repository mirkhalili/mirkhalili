# CMS public_html root — Apache 2.4 + mod_rewrite/mod_headers
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Require HTTPS when the server exposes the standard HTTPS variable.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Keep the public URLs extension-free.
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^work/([^/.]+)/?$ project.php?slug=$1 [QSA,L]
  RewriteRule ^work/?$ work.php [L]
  RewriteRule ^(about|services|contact)/?$ $1.php [L]

</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Never serve private/configuration, source, or database files.
<FilesMatch "(^\.|\.(?:sql|md|log|ini|dist|sample\.php|bak|old)$|^VERSION$)">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>
